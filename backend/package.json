{
    "name": "central-de-anime-api",
    "version": "1.0.0",
    "description": "API da Central de Anime",
    "scripts": {
        "dev": "tsx src/server.ts",
        "dev:local": "cross-env APP_ENV=local tsx src/server.ts",
        "dev:staging": "cross-env APP_ENV=staging tsx src/server.ts",
        "dev:production": "cross-env APP_ENV=production APP_RUNTIME=readonly tsx src/server.ts",
        "dev:production:readonly": "npm run dev:production",
        "start": "node dist/src/server.js",
        "test": "cross-env APP_ENV=test vitest run",
        "test:watch": "cross-env APP_ENV=test vitest",
        "test:dev": "npm test",
        "test:testdb": "npm test",
        "test:coverage": "cross-env APP_ENV=test vitest run --coverage",
        "test:coverage:html": "cross-env APP_ENV=test vitest run --coverage",
        "test:coverage:testdb": "cross-env APP_ENV=test vitest run --coverage --reporter=junit --outputFile=.github/reports/report.xml",
        "test:ci": "cross-env APP_ENV=test vitest run --reporter=default --reporter=junit --outputFile=report.xml",
        "test:all": "npm run test && npm run test:coverage",
        "test:full": "npm run test",
        "test:seed": "cross-env APP_ENV=test vitest run src/tests/seed",
        "env:prepare": "node scripts/prepare-environments.mjs",
        "env:check": "tsx scripts/check-environment.ts",
        "env:check:local": "cross-env APP_ENV=local tsx scripts/check-environment.ts",
        "env:check:staging": "cross-env APP_ENV=staging tsx scripts/check-environment.ts",
        "db:inspect:local": "cross-env APP_ENV=local tsx scripts/inspect-local.ts",
        "db:inspect:staging": "cross-env APP_ENV=staging tsx scripts/inspect-staging.ts",
        "prod:inspect": "cross-env APP_ENV=production tsx scripts/inspect-production.ts",
        "prod:migrate": "cross-env APP_ENV=production tsx scripts/prod-migrate.ts",
        "prod:seed": "cross-env APP_ENV=production tsx scripts/prod-seed.ts",
        "typecheck": "tsc --noEmit",
        "build": "npm run db:generate && npm run typecheck && node scripts/prepare-build.mjs && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
        "db:generate": "node scripts/prisma.mjs generate",
        "db:generate:test": "node scripts/prisma.mjs generate",
        "db:migrate": "node scripts/prisma.mjs migrate dev",
        "db:migrate:relations": "node scripts/prisma.mjs migrate dev --name add-anime-genero-plataforma",
        "db:migrate:test": "cross-env APP_ENV=test node scripts/prisma.mjs migrate dev",
        "db:reset": "node scripts/prisma.mjs migrate reset --force",
        "db:reset:test": "cross-env APP_ENV=test node scripts/prisma.mjs migrate reset --force",
        "seed:validate": "tsx src/seed/validacoes/Entrada.ts",
        "seed:all": "tsx src/seed/index.ts",
        "seed:status": "tsx src/seed/auxiliares/Status.ts",
        "seed:generos": "tsx src/seed/auxiliares/Generos.ts",
        "seed:estudios": "tsx src/seed/auxiliares/Estudios.ts",
        "seed:plataformas": "tsx src/seed/auxiliares/Plataformas.ts",
        "seed:tags": "tsx src/seed/auxiliares/Tags.ts",
        "seed:franquias": "tsx src/seed/auxiliares/Franquias.ts",
        "seed:capas": "tsx src/seed/auxiliares/Capas.ts",
        "seed:estacoes": "tsx src/seed/auxiliares/Estacoes.ts",
        "seed:animes": "tsx src/seed/entidades/Animes.ts",
        "seed:personagens": "tsx src/seed/entidades/Personagens.ts",
        "seed:episodios": "tsx src/seed/entidades/Episodios.ts",
        "seed:anime-genero": "tsx src/seed/relacionamentos/AnimeGenero.ts",
        "seed:anime-personagem": "tsx src/seed/relacionamentos/AnimePersonagem.ts",
        "seed:anime-plataforma": "tsx src/seed/relacionamentos/AnimePlataforma.ts",
        "seed:anime-tag": "tsx src/seed/relacionamentos/AnimeTag.ts",
        "seed:anime-status": "tsx src/seed/atualizacoes/AnimeStatus.ts",
        "fixtures:usuarios": "tsx src/seed/fixtures/Usuarios.ts",
        "swagger-autogen": "tsx scripts/swagger-autogen.js",
        "swagger:generate": "npm run swagger-autogen"
    },
    "keywords": [
        "anime",
        "api",
        "nodejs",
        "typescript",
        "express",
        "postgresql",
        "prisma",
        "swagger"
    ],
    "author": "Dev Seravali",
    "license": "ISC",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "vitest": {
        "testTimeout": 20000
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "7.8.0",
        "@sendgrid/mail": "^8.1.6",
        "axios": "^1.13.5",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.4.1",
        "express-session": "^1.19.0",
        "helmet": "^8.1.0",
        "iconv-lite": "^0.7.3",
        "jsonwebtoken": "^9.0.3",
        "jwk-to-pem": "^2.0.7",
        "multer": "^2.0.2",
        "node-cache": "^5.1.2",
        "nodemailer": "^8.0.11",
        "object-inspect": "^1.13.4",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "pg": "^8.22.0",
        "redis": "^6.0.0",
        "resend": "^6.20.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.18.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/jwk-to-pem": "^2.0.3",
        "@types/multer": "^2.0.2",
        "@types/node": "^25.9.8",
        "@types/node-cache": "^4.1.3",
        "@types/nodemailer": "^7.0.12",
        "@types/passport": "^1.0.17",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/pg": "^8.21.0",
        "@types/supertest": "^6.0.3",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@vitest/coverage-v8": "^4.1.5",
        "cross-env": "^10.1.0",
        "dotenv-cli": "^11.0.0",
        "prisma": "7.8.0",
        "supertest": "^7.2.2",
        "swagger-autogen": "^2.23.7",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsc-alias": "^1.9.10",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.5"
    }
}
