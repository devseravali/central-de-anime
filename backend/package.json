{
  "name": "central-de-anime-api",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:dev": "cross-env NODE_ENV=development vitest run",
    "test:testdb": "cross-env NODE_ENV=test vitest run",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "test:coverage:html": "cross-env NODE_ENV=test vitest run --coverage",
    "test:coverage:testdb": "cross-env NODE_ENV=test vitest run --coverage --reporter=junit --outputFile=.github/reports/report.xml",
    "test:ci": "cross-env NODE_ENV=test vitest run --reporter=junit --outputFile=report.xml",
    "test:all": "npm run test && npm run test:coverage",
    "test:full": "npm run db:migrate:test && npm run seed:test && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate reset --force",
    "db:test:seed": "dotenv -e .env.test -- tsx src/import/index.ts",
    "seed:test": "npm run db:test:seed",
    "seed:dev": "tsx src/import/index.ts",
    "swagger-autogen": "tsx scripts/swagger-autogen.js",
    "swagger-autogen:v1": "tsx scripts/swagger-autogen.js v1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
