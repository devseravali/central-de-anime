generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Anime {
  id                  Int     @id @default(autoincrement())
  titulo              String
  tipo                String
  ano                 Int
  sinopse             String  @db.VarChar(5000)
  capaUrl             String?
  quantidadeEpisodios Int     @default(0)

  franquiaId Int?
  franquia   Franquia? @relation(fields: [franquiaId], references: [id])

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id])

  statusId Int
  status   Status @relation(fields: [statusId], references: [id])

  estacaoId Int?
  estacao   Estacao? @relation(fields: [estacaoId], references: [id])

  temporadas Temporada[]
  episodios  Episodio[]

  tags        AnimeTagAnime[]
  personagens AnimePersonagem[]

  favoritosUsuarios UsuarioFavoritoAnime[]
  notasUsuarios     NotaAnimeUsuario[]

  cache CacheAnime?
}

model Estacao {
  id   Int    @id @default(autoincrement())
  nome String @unique

  animes Anime[]
}

model Franquia {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  descricao String?
  anoInicio Int?

  animes Anime[]
}

model Estudio {
  id   Int    @id @default(autoincrement())
  nome String @unique

  animes Anime[]
}

model Status {
  id   Int    @id @default(autoincrement())
  nome String @unique

  animes Anime[]
}

model Temporada {
  id     Int  @id @default(autoincrement())
  numero Int
  ano    Int?

  animeId Int
  anime   Anime @relation(fields: [animeId], references: [id])

  episodios Episodio[]

  @@unique([animeId, numero])
}

model Episodio {
  id      Int    @id @default(autoincrement())
  numero  Int
  titulo  String
  sinopse String @db.VarChar(2000)

  imagem       String?
  dataExibicao DateTime?

  temporadaId Int
  temporada   Temporada @relation(fields: [temporadaId], references: [id])

  animeId Int
  anime   Anime @relation(fields: [animeId], references: [id])

  watchProgress WatchProgress[]

  @@unique([temporadaId, numero])
}

model Usuario {
  id     Int     @id @default(autoincrement())
  nome   String
  email  String  @unique
  senha  String
  avatar String?

  status String @default("ativo")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  admin Admin?

  sessoes Sessao[]

  favoritos UsuarioFavoritoAnime[]
  notas     NotaAnimeUsuario[]

  personagensFav PersonagemFavorito[]

  watchProgress WatchProgress[]

  ranking RankingUsuario?
}

model WatchProgress {
  id Int @id @default(autoincrement())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  episodioId Int
  episodio   Episodio @relation(fields: [episodioId], references: [id], onDelete: Cascade)

  assistido          Boolean @default(false)
  segundosAssistidos Int     @default(0)
  porcentagem        Float   @default(0)

  atualizadoEm DateTime @updatedAt

  @@unique([usuarioId, episodioId])
}

model RankingUsuario {
  id Int @id @default(autoincrement())

  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  pontos Int @default(0)
  nivel  Int @default(1)

  totalEpisodiosAssistidos Int @default(0)

  atualizadoEm DateTime @updatedAt
}

model CacheAnime {
  id Int @id @default(autoincrement())

  animeId Int   @unique
  anime   Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  viewsCount Int @default(0)
  likesCount Int @default(0)

  rankingScore Float @default(0)

  updatedAt DateTime @updatedAt
}

model AnimeTag {
  id   Int    @id @default(autoincrement())
  nome String @unique

  animes AnimeTagAnime[]
}

model AnimeTagAnime {
  animeId Int
  tagId   Int

  anime Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  tag   AnimeTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([animeId, tagId])
}

model UsuarioFavoritoAnime {
  usuarioId Int
  animeId   Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  anime   Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@id([usuarioId, animeId])
}

model NotaAnimeUsuario {
  id Int @id @default(autoincrement())

  usuarioId Int
  animeId   Int
  nota      Float

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  anime   Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, animeId])
}

model Personagem {
  id     Int    @id @default(autoincrement())
  nome   String
  imagem String
  sobre  String @db.VarChar(5000)

  animes    AnimePersonagem[]
  favoritos PersonagemFavorito[]
}

model AnimePersonagem {
  animeId      Int
  personagemId Int

  anime      Anime      @relation(fields: [animeId], references: [id])
  personagem Personagem @relation(fields: [personagemId], references: [id])

  @@id([animeId, personagemId])
}

model PersonagemFavorito {
  id Int @id @default(autoincrement())

  usuarioId    Int
  personagemId Int

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  personagem Personagem @relation(fields: [personagemId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, personagemId])
}

model Admin {
  id Int @id @default(autoincrement())

  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nivel String @default("moderador")

  criadoEm DateTime @default(now())
}

model Sessao {
  id Int @id @default(autoincrement())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  refreshTokenHash String

  dispositivo String?
  ip          String?
  userAgent   String?

  expiraEm   DateTime
  revogadoEm DateTime?
}

model Capas {
  id Int @id @default(autoincrement())

  nome_original String
  nome_salvo    String
  caminho       String
  mime_type     String
}

model Filtro {
  id    Int    @id @default(autoincrement())
  nome  String @unique
  valor String
}
