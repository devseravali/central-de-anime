generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Anime {
  id                  Int     @id @default(autoincrement())
  titulo              String
  tipo                String
  temporada           Int
  ano                 Int
  sinopse             String  @db.VarChar(5000)
  capaUrl             String?
  quantidadeEpisodios Int     @default(0)

  franquiaId Int?
  franquia   Franquia? @relation(fields: [franquiaId], references: [id])

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id])

  statusId Int
  status   Status @relation(fields: [statusId], references: [id])

  episodios Episodio[]

  tags        AnimeTagAnime[]
  personagens AnimePersonagem[]
  generos     AnimeGenero[]
  plataformas AnimePlataforma[]

  favoritosUsuarios UsuarioFavoritoAnime[]
  notasUsuarios     NotaAnimeUsuario[]

  cache CacheAnime?
}

model Temporada {
  id   Int    @id @default(autoincrement())
  nome String @unique

  episodios Episodio[]
}

model Franquia {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  descricao String?
  anoInicio Int?

  animes Anime[]
}

model Estudio {
  id              Int    @id @default(autoincrement())
  nome            String @unique
  principaisObras String @db.VarChar(5000)

  animes Anime[]
}

model Status {
  id   Int    @id @default(autoincrement())
  nome String @unique

  animes Anime[]
}

model Episodio {
  id      Int    @id @default(autoincrement())
  numero  Int
  titulo  String
  sinopse String @db.VarChar(2000)

  imagemUrl    String?
  dataExibicao DateTime?

  temporadaId Int
  temporada   Temporada @relation(fields: [temporadaId], references: [id])
  animeId     Int
  anime       Anime @relation(fields: [animeId], references: [id])

  watchProgress WatchProgress[]

  @@unique([temporadaId, numero])
}

model Usuario {
  id     Int     @id @default(autoincrement())
  nome   String
  email  String  @unique
  senha  String
  avatar String?

  resetSenhaTokenHash String?
  resetSenhaExpiraEm  DateTime?

  status String @default("ativo")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  admin Admin?

  sessoes Sessao[]

  favoritos UsuarioFavoritoAnime[]
  notas     NotaAnimeUsuario[]

  personagensFav PersonagemFavorito[]

  watchProgress WatchProgress[]

  ranking RankingUsuario?
}

model WatchProgress {
  id Int @id @default(autoincrement())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  episodioId Int
  episodio   Episodio @relation(fields: [episodioId], references: [id], onDelete: Cascade)

  assistido          Boolean @default(false)
  segundosAssistidos Int     @default(0)
  porcentagem        Float   @default(0)

  atualizadoEm DateTime @updatedAt

  @@unique([usuarioId, episodioId])
}

model RankingUsuario {
  id Int @id @default(autoincrement())

  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  pontos Int @default(0)
  nivel  Int @default(1)

  totalEpisodiosAssistidos Int @default(0)

  atualizadoEm DateTime @updatedAt
}

model CacheAnime {
  id Int @id @default(autoincrement())

  animeId Int   @unique
  anime   Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  viewsCount Int @default(0)
  likesCount Int @default(0)

  rankingScore Float @default(0)

  updatedAt DateTime @updatedAt
}

model AnimeTag {
  id   Int    @id @default(autoincrement())
  nome String @unique

  animes AnimeTagAnime[]
}

model AnimeTagAnime {
  animeId Int
  tagId   Int

  anime Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  tag   AnimeTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([animeId, tagId])
}

model UsuarioFavoritoAnime {
  usuarioId Int
  animeId   Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  anime   Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@id([usuarioId, animeId])
}

model NotaAnimeUsuario {
  id Int @id @default(autoincrement())

  usuarioId Int
  animeId   Int
  nota      Float

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  anime   Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, animeId])
}

model Personagem {
  id     Int    @id @default(autoincrement())
  nome   String
  imagem String
  sobre  String @db.VarChar(5000)

  idade_inicial  String?
  sexo           String?
  papel          String?
  aniversario    String?
  altura_inicial String?
  afiliacao      String?

  animes    AnimePersonagem[]
  favoritos PersonagemFavorito[]
}

model AnimePersonagem {
  animeId      Int
  personagemId Int

  anime      Anime      @relation(fields: [animeId], references: [id])
  personagem Personagem @relation(fields: [personagemId], references: [id])

  @@id([animeId, personagemId])
}

model AnimeGenero {
  animeId   Int
  generoId  Int

  anime  Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  genero Genero  @relation(fields: [generoId], references: [id], onDelete: Cascade)

  @@id([animeId, generoId])
}

model AnimePlataforma {
  animeId      Int
  plataformaId Int

  anime      Anime      @relation(fields: [animeId], references: [id], onDelete: Cascade)
  plataforma Plataforma @relation(fields: [plataformaId], references: [id], onDelete: Cascade)

  @@id([animeId, plataformaId])
}

model PersonagemFavorito {
  id Int @id @default(autoincrement())

  usuarioId    Int
  personagemId Int

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  personagem Personagem @relation(fields: [personagemId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, personagemId])
}

model Admin {
  id Int @id @default(autoincrement())

  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nivel String @default("moderador")

  criadoEm DateTime @default(now())
}

model Sessao {
  id Int @id @default(autoincrement())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  refreshTokenHash String

  dispositivo String?
  ip          String?
  userAgent   String?

  expiraEm   DateTime
  revogadoEm DateTime?
}

model Capas {
  id Int @id @default(autoincrement())

  nome_original String
  nome_salvo    String
  caminho       String
  mime_type     String
}

model Genero {
  id   Int    @id @default(autoincrement())
  nome String @unique
  animes AnimeGenero[]
}

model Plataforma {
  id   Int    @id @default(autoincrement())
  nome String @unique
  animes AnimePlataforma[]
}

model Filtro {
  id    Int    @id @default(autoincrement())
  nome  String @unique
  valor String
}
