{
  "compilerOptions": {
    
    "target": "ES2022",

    "module": "ESNext",

    "moduleResolution": "bundler",

    "rootDir": ".",

    "outDir": "dist",

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "types": ["vitest/globals", "node"]
  },

  "include": [
    "src/**/*",
    "tests/**/*",
    "scripts/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}