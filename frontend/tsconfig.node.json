{
  "compilerOptions": {
    "composite": true,

    "target": "ES2022",
    "lib": ["ES2022"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "strict": true,

    "resolveJsonModule": true,

    "isolatedModules": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "noEmit": true,

    "types": ["node"],

    "ignoreDeprecations": "6.0"
  },

  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}