{
  "name": "central-de-anime-monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "test:backend": "npm --workspace backend test",
    "test:frontend": "npm --workspace frontend test",
    "test": "npm run test:backend && npm run test:frontend",
    "coverage:backend": "npm --workspace backend run test:coverage",
    "coverage:frontend": "npm --workspace frontend run test:coverage",
    "coverage": "npm run coverage:backend && npm run coverage:frontend",
    "build:backend": "npm --workspace backend run build",
    "build:frontend": "npm --workspace frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "seed:backend": "npm --workspace backend run seed:dev"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.27.7",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv-cli": "^11.0.0",
    "vite": "^8.0.7",
    "vite-plugin-import-maps": "^0.1.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.2",
    "@types/react-router-dom": "^5.3.3",
    "cors": "^2.8.6",
    "react-router-dom": "^7.14.0",
    "resend": "^6.9.4"
  }
}
